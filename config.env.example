# ============================================================================
# Global Stremio — configuration
# Copy to config.env (local) OR set as Koyeb environment variables/secrets.
# ============================================================================

# --- Telegram userbot (REQUIRED — powers indexing AND streaming) ------------
# Get these from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here
# Session string of the user account that is a member of the channels.
# Generate with any Pyrogram/PyroFork string-session tool.
SESSION_STRING=1BQ...your_session_string...=

# --- Optional bots for high-bitrate channels (e.g. 4K video songs) ----------
# Bot tokens have a higher GetFile rate limit than a user session. Route your
# heavy channels through them. Create via @BotFather, then add each bot as
# ADMIN to each channel below. Multiple bots load-balance for more throughput.
BOT_TOKENS=1234567890:AA...,9876543210:BB...
# Comma-separated channel ids the bots serve (everything else uses the userbot).
BOT_CHANNELS=-1001234567890

# --- MongoDB GlobalDB (REQUIRED) --------------------------------------------
# Use your existing dbFyvio GlobalDB so all indexed data works immediately.
MONGO_URI=mongodb+srv://USER:PASS@host.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dbFyvio

# --- TMDb (metadata during indexing) ----------------------------------------
TMDB_API=your_tmdb_api_key

# --- Server -----------------------------------------------------------------
# Your public Koyeb URL (e.g. https://myapp-xxx.koyeb.app) — REQUIRED for
# keepalive + Stremio stream URLs.
BASE_URL=https://myapp-xxxxx.koyeb.app
PORT=8000

# Single shared access token for the Stremio addon (any random string).
API_TOKEN=change_me_to_a_long_random_token

# Key for the /api/* management endpoints (optional; the panel uses login too).
ADMIN_KEY=change_me_to_another_random_key

# Admin login for the GlobalDB panel (same as the original project).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Channels to index (optional) -------------------------------------------
# Comma-separated. Leave empty to auto-derive from the existing GlobalDB state.
# CHANNELS=-1001234567890,-1009876543210

# --- Streaming tuning (Koyeb free tier friendly) -----------------------------
STREAM_PARALLELISM=2
STREAM_PREFETCH=4
BOT_STREAM_PARALLELISM=4
BOT_STREAM_PREFETCH=8
KEEPALIVE_MINUTES=15

# --- PreDVD Auto-Leecher & Leech Group Automation ---------------------------
# Enables 24/7 automated monitoring of 1TamilMV feed for new Tamil PreDVDs
PREDVD_ENABLED=true
# Your Leech Supergroup ID (e.g. -100)
PREDVD_GROUP_ID=-100
# The exact command prefix your leech bot responds to
PREDVD_COMMAND_PREFIX=/qbleech
# Feed URL (can point to your custom scraper repo raw movies.json)
PREDVD_FEED_URL=
# Minimum size threshold in MB (800MB captures 720p AVC, ignores 400MB rips)
PREDVD_MIN_SIZE_MB=800
# Only 1 file (720p AVC) leeched automatically per movie
PREDVD_MAX_FILES_PER_MOVIE=1
# Auto-remove old PreDVD streams when official WEB-DL / HD print arrives
PREDVD_AUTO_PURGE_ON_WEBDL=true
# Feed check frequency (minutes)
PREDVD_POLL_INTERVAL_MINUTES=15
