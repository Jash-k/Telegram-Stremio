# ============================================================================
# Global Stremio — configuration
# Copy to config.env (local) OR set as Koyeb environment variables/secrets.
# ============================================================================

# --- Telegram userbot (REQUIRED — powers indexing AND streaming) ------------
# Get these from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here
# Session string of the user account that is a member of the channels.
# Generate with any Pyrogram/PyroFork string-session tool.
SESSION_STRING=1BQ...your_session_string...=

# --- Optional bots for high-bitrate channels (e.g. 4K video songs) ----------
# Bot tokens have a higher GetFile rate limit than a user session. Route your
# heavy channels through them. Create via @BotFather, then add each bot as
# ADMIN to each channel below. Multiple bots load-balance for more throughput.
BOT_TOKENS=1234567890:AA...,9876543210:BB...
# Comma-separated channel ids the bots serve (everything else uses the userbot).
BOT_CHANNELS=-1001234567890

# --- MongoDB GlobalDB (REQUIRED) --------------------------------------------
# Use your existing dbFyvio GlobalDB so all indexed data works immediately.
MONGO_URI=mongodb+srv://USER:PASS@host.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dbFyvio

# --- TMDb (metadata during indexing) ----------------------------------------
TMDB_API=your_tmdb_api_key

# --- Server -----------------------------------------------------------------
# Your public Koyeb URL (e.g. https://myapp-xxx.koyeb.app) — REQUIRED for
# keepalive + Stremio stream URLs.
BASE_URL=https://myapp-xxxxx.koyeb.app
PORT=8000

# Single shared access token for the Stremio addon (any random string).
API_TOKEN=change_me_to_a_long_random_token

# Key for the /api/* management endpoints (optional; the panel uses login too).
ADMIN_KEY=change_me_to_another_random_key

# Admin login for the GlobalDB panel (same as the original project).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Channels to index (optional) -------------------------------------------
# Comma-separated. Leave empty to auto-derive from the existing GlobalDB state.
# CHANNELS=-1001234567890,-1009876543210

# --- Streaming tuning (Koyeb free tier friendly) -----------------------------
STREAM_PARALLELISM=2
STREAM_PREFETCH=4
BOT_STREAM_PARALLELISM=4
BOT_STREAM_PREFETCH=8
KEEPALIVE_MINUTES=15
# --- GitHub Actions workflow triggers ---------------------------------------
# Reliably fire workflow_dispatch at your scraper / playlist repos instead of
# relying on GitHub's flaky scheduled cron (which silently skips runs).
#
# ONE fine-grained PAT drives every target:
#   GitHub → Settings → Developer settings → Fine-grained tokens → Generate
#   • Repository access → "Only select repositories" →
#       Jash-k/mv_scrapper  AND  Jash-k/live_play
#   • Permissions → Repository permissions → Actions → "Read and write"
# Paste it into GITHUB_DISPATCH_TOKEN (a Koyeb SECRET), then redeploy.
# A 401 "Bad credentials" means GitHub did not recognise the token at all —
# expired / revoked / mistyped. Diagnose with:
#   python3 tools/check_github_dispatch.py
# Leave GITHUB_DISPATCH_TOKEN blank to disable every trigger.
GITHUB_DISPATCH_TOKEN=

# Targets: comma-separated, each one
#   repo|workflow.yml|minutes|ref|input=value,input2=value2
# `repo` may be bare (GITHUB_DISPATCH_OWNER is prefixed) or "owner/repo".
# `ref` and the inputs are optional. Input values are coerced to the type the
# workflow declares (true/false -> boolean, digits -> number, else string).
#
# Default = tamilmv every 30 min · moviesda every 6 h · live playlist every 1 h.
# The live_play workflow takes a `force` input; false = health-check only (the
# playlist is rebuilt from a static source, so forcing just re-commits the same
# file). Set force=true to always rebuild.
GITHUB_DISPATCH_TARGETS=mv_scrapper|scrape.yml|30,mv_scrapper|moviesda.yml|360,live_play|jash-live.yml|60||force=false

# Legacy single-target knobs. Used ONLY when GITHUB_DISPATCH_TARGETS is empty,
# and as the source of the default owner/ref.
GITHUB_DISPATCH_OWNER=Jash-k
GITHUB_DISPATCH_REPO=mv_scrapper
GITHUB_DISPATCH_WORKFLOW=scrape.yml
GITHUB_DISPATCH_REF=main
GITHUB_DISPATCH_MINUTES=30
# Media-session pool per datacenter (higher = faster private-channel streaming).
STREAM_MEDIA_SESSIONS=3
BOT_STREAM_MEDIA_SESSIONS=4
FLOOD_COOLDOWN_SECONDS=12
# Periodic incremental re-scan every N minutes. New files are ALREADY indexed in
# real time by live handlers, so this backup scan is OFF by default (it competes
# with the panel + streaming). Set true only if you want the periodic rescan.
BACKGROUND_SYNC_ENABLED=false

# One-shot series metadata self-heal at boot (re-derives season/episode ranges
# from stored filenames, relinks mis-matched shows like Bigg Boss Tamil → Hindi
# Bigg Boss, retries the unindexed queue). Idempotent; set false after first run.
SERIES_REPAIR_ON_START=true
BACKGROUND_SYNC_MINUTES=5

# --- PreDVD Auto-Leecher & Leech Group Automation ---------------------------
# Enables 24/7 automated monitoring of TamilMV feed for new Tamil PreDVDs
PREDVD_ENABLED=true
# Your Leech Supergroup ID (e.g. -1001234567890 or @YourLeechGroup)
PREDVD_GROUP_ID=
# The exact command prefix your leech bot responds to (e.g. /qbleech@YourLeechBot or /leech)
PREDVD_COMMAND_PREFIX=/qbleech
# Feed URL (point to your custom scraper repo's raw movies.json)
PREDVD_FEED_URL=
# Minimum size threshold in MB (800MB captures 720p AVC, ignores 400MB rips)
PREDVD_MIN_SIZE_MB=800
# Only 1 file (720p AVC) leeched automatically per movie
PREDVD_MAX_FILES_PER_MOVIE=1
# Feed check frequency (minutes)
PREDVD_POLL_INTERVAL_MINUTES=15

# --- PreDVD cleanup bot (optional; for deleting old dump-channel messages) ---
# When the official HD/WEB-DL arrives, the global indexer cleanup removes the
# old PreDVD DB record AND (via this bot) deletes that old PreDVD MESSAGE from
# your dump channel. This must be a SEPARATE bot token whose bot is an ADMIN
# with "Delete messages" permission in the dump channel. The indexing userbot
# stays a normal member of the dump channel. Leave blank to skip Telegram
# message deletion (the DB row is still removed; your channel bot can delete).
PREDVD_CLEANUP_BOT_TOKEN=
# The dump channel id, e.g. -1001234567890. ONLY this channel's messages are
# ever deleted; your regular media channels are never touched.
PREDVD_DUMP_CHANNEL_ID=
